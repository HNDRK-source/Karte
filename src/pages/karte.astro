---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapView from "../components/MapView.astro";
import { t } from "../i18n/ui";
const lang = "de" as const;
---
<BaseLayout lang={lang} title={t(lang, "nav.karte")} description="Interaktive Karte der erfassten Ulmen.">
  <section class="container-wide py-8">
    <h1 class="font-serif text-3xl font-semibold md:text-4xl">{t(lang, "nav.karte")}</h1>
    <p class="mt-3 max-w-prose text-ulme-800">Bestand, Impfungen und Meldungen. Klicke auf einen Marker für Details.</p>
  </section>
  <MapView lang={lang} />
</BaseLayout>
