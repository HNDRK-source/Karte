---
import { t, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;

const hint = lang === "de"
  ? "Standorte der Ulmen sind aus Datenschutzgründen auf etwa Quartiers-Ebene unscharf dargestellt."
  : "Elm locations are intentionally blurred to roughly neighbourhood level for privacy reasons.";
const legendUlme = lang === "de" ? "Ulme" : "Elm";
const legendEvent = lang === "de" ? "Veranstaltung / Seminar" : "Event / seminar";
---
<div class="container-wide pb-4 text-sm text-ulme-800">{hint}</div>
<div id="map" class="h-[70vh] w-full border-t border-ulme-100" aria-label={t(lang, "nav.karte")}></div>
<div class="container-wide flex flex-wrap items-center gap-4 py-3 text-sm text-ulme-800">
  <span class="flex items-center gap-2">
    <span class="inline-block h-3 w-3 rounded-full border-2 border-ulme-700 bg-ulme-400"></span>
    {legendUlme}
  </span>
  <span class="flex items-center gap-2">
    <span class="inline-block h-3 w-3 rotate-45 border-2 border-amber-700 bg-amber-400"></span>
    {legendEvent}
  </span>
</div>
<noscript>
  <p class="container-wide py-4 text-ulme-800">{t(lang, "map.error")}</p>
</noscript>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script>
  import L from "leaflet";

  const map = L.map("map");
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);
  map.setView([51.1, 11.4], 6);

  const ulmeStyle = { radius: 7, color: "#3a5429", weight: 2, fillColor: "#a4c089", fillOpacity: 0.85 };

  function eventIcon() {
    const svg = `
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18">
        <rect x="3" y="3" width="12" height="12" transform="rotate(45 9 9)"
              fill="#fbbf24" stroke="#b45309" stroke-width="2"/>
      </svg>`;
    return L.divIcon({ html: svg, className: "", iconSize: [18, 18], iconAnchor: [9, 9] });
  }

  const dataUrl = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") + "/data/ulmen.geojson";
  fetch(dataUrl, { cache: "no-cache" })
    .then((r) => { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
    .then((data) => {
      const layer = L.geoJSON(data, {
        pointToLayer: (feature, latlng) => {
          if (feature.properties?.category === "veranstaltung") {
            return L.marker(latlng, { icon: eventIcon() });
          }
          return L.circleMarker(latlng, ulmeStyle);
        },
        onEachFeature: (feature, layer) => {
          const p = feature.properties ?? {};
          let html;
          if (p.category === "veranstaltung") {
            html = `<strong>${p.name}</strong>`;
          } else {
            const nr = p.nr ? `Nr. ${p.nr}` : "Ulme";
            const art = p.art ?? "";
            html = `<strong>${nr}</strong>${art ? "<br>" + art : ""}`;
          }
          layer.bindPopup(html);
        },
      }).addTo(map);
      try {
        const b = layer.getBounds();
        if (b.isValid()) map.fitBounds(b.pad(0.15));
      } catch {}
    })
    .catch((err) => { console.error(err); });
</script>
