---
import { t, routes, altLang, type Lang } from "../i18n/ui";

interface Props { lang: Lang; currentPath: string }
const { lang, currentPath } = Astro.props;
const r = routes[lang];

const navItems = [
  { href: r.ulme,           label: t(lang, "nav.ulme") },
  { href: r.ulmenkrankheit, label: t(lang, "nav.ulmenkrankheit") },
  { href: r.ulmenschutz,    label: t(lang, "nav.ulmenschutz") },
  { href: r.dutchtrig,      label: t(lang, "nav.dutchtrig") },
  { href: r["fuer-kommunen"], label: t(lang, "nav.kommunen") },
  { href: r["fuer-private"],  label: t(lang, "nav.private") },
  { href: r.karte,          label: t(lang, "nav.karte") },
  { href: r.mitmachen,      label: t(lang, "nav.mitmachen") },
  { href: r.wissen,         label: t(lang, "nav.wissen") },
  { href: r["ueber-uns"],   label: t(lang, "nav.ueberuns") },
];

const other = altLang(lang);
const otherHref = currentPath.startsWith("/en/")
  ? currentPath.replace(/^\/en\//, "/")
  : currentPath === "/en"
    ? "/"
    : "/en" + (currentPath.startsWith("/") ? currentPath : "/" + currentPath);
---
<header class="border-b border-ulme-100 bg-white">
  <div class="container-wide flex flex-wrap items-center justify-between gap-4 py-4">
    <a href={r.home} class="flex items-center gap-2 no-underline">
      <span class="inline-block h-8 w-8 rounded-full bg-ulme-600"></span>
      <span class="font-serif text-lg font-semibold text-ulme-900">{t(lang, "site.title")}</span>
    </a>
    <nav aria-label="Hauptnavigation" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      {navItems.map(({ href, label }) => (
        <a href={href} class={`no-underline hover:underline ${currentPath === href ? "font-semibold text-ulme-800" : "text-ulme-700"}`}>{label}</a>
      ))}
      <a href={otherHref} class="ml-2 rounded border border-ulme-200 px-2 py-0.5 text-xs no-underline text-ulme-700 hover:bg-ulme-50" aria-label={t(lang, "lang.switch")}>{other.toUpperCase()}</a>
    </nav>
  </div>
</header>
